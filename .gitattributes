# Line endings: shell scripts must stay LF even on Windows (Git Bash breaks on CRLF)
* text=auto
*.sh text eol=lf
tools/hooks/* text eol=lf

# Source code
*.cpp text
*.h text
*.cs text
*.json text
*.md text

# Unity files
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.meta text eol=lf
*.uss text
*.uxml text

# Binary files
*.png binary
*.jpg binary
*.dll binary
*.pdf binary
