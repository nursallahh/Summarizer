# =====================================================================
# Course Archive — .gitignore
# Rule: personal files, labels, models and keys NEVER enter the repository.
# Note: .gitignore alone is not enough (git add -f bypasses it);
#       the pre-commit check is the second layer of protection.
# =====================================================================

# ---------------------------------------------------------------------
# 1) PERSONAL DATA AND TEST DATA (most important section)
# Real data lives outside the repository: C:\DersArsivi-veri\
# In case it is accidentally copied into the repo anyway:
# ---------------------------------------------------------------------
/data/
/veri/
/eval/data/
/eval/private/
*.etiket.csv
*etiketler*.csv
*labels*.csv

# Images, documents and media: all blocked by default...
*.jpg
*.jpeg
*.png
*.heic
*.webp
*.bmp
*.tif
*.tiff
*.pdf
*.doc
*.docx
*.ppt
*.pptx
*.mp3
*.m4a
*.wav
*.ogg
*.mp4
*.mov

# ...and only allowed in these folders:
# - Unity UI images (icons, backgrounds)
# - Screenshots in docs (must not contain personal data!)
# - Synthetic test files (NOT real course material)
!/unity/Assets/**/*.png
!/unity/Assets/**/*.jpg
!/docs/images/**
!/core/tests/fixtures/**

# ---------------------------------------------------------------------
# 2) AI MODELS AND LANGUAGE DATA (gigabytes, downloaded at run time)
# ---------------------------------------------------------------------
/models/
*.gguf
*.onnx
*.safetensors
*.traineddata

# ---------------------------------------------------------------------
# 3) KEYS AND SECRETS
# The API key is stored in Windows Credential Manager, never in a file.
# ---------------------------------------------------------------------
.env
.env.*
*.key
*.pem
secrets.*
*api_key*
*apikey*

# ---------------------------------------------------------------------
# 4) LOCAL DATABASE AND LOGS
# ---------------------------------------------------------------------
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.log
/logs/

# ---------------------------------------------------------------------
# 5) C++ / CMAKE / VCPKG
# ---------------------------------------------------------------------
/build/
/out/
/cmake-build-*/
CMakeUserPresets.json
CMakeCache.txt
CMakeFiles/
/vcpkg_installed/
compile_commands.json

# ---------------------------------------------------------------------
# 6) VISUAL STUDIO / IDE
# ---------------------------------------------------------------------
.vs/
*.user
*.suo
*.sdf
*.opensdf
*.VC.db
*.VC.opendb
*.ipch
.idea/
.vscode/*
!.vscode/extensions.json

# ---------------------------------------------------------------------
# 7) UNITY (project lives in unity/)
# ---------------------------------------------------------------------
/unity/[Ll]ibrary/
/unity/[Tt]emp/
/unity/[Oo]bj/
/unity/[Bb]uild/
/unity/[Bb]uilds/
/unity/[Ll]ogs/
/unity/[Uu]ser[Ss]ettings/
/unity/[Mm]emoryCaptures/
/unity/[Rr]ecordings/
/unity/.vscode/
/unity/.idea/
/unity/*.csproj
/unity/*.sln
/unity/*.slnx
/unity/*.pidb
/unity/*.booproj
/unity/*.unityproj
/unity/*.apk
/unity/*.aab
/unity/sysinfo.txt
/unity/crashlytics-build.properties

# The core DLL copied in at build time is not committed
# (its .meta file is; it holds Unity's import settings).
/unity/Assets/Plugins/x86_64/*.dll
/unity/Assets/Plugins/x86_64/*.pdb

# ---------------------------------------------------------------------
# 8) OPERATING SYSTEM
# ---------------------------------------------------------------------
Thumbs.db
desktop.ini
$RECYCLE.BIN/
.DS_Store
